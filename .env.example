# Verídico Intelligence — server-side configuration (Vercel project env vars).
# Never expose these in client code.

# Abstract Intelligence gateway (future: SON Intelligence router shared by Santos and Verídico).
# Leave empty to run the demo with the deterministic demo provider (no LLM).
INTELLIGENCE_GATEWAY_URL=
INTELLIGENCE_API_KEY=

# Where "Analyze my company" requests are delivered. Empty → logged to Vercel function logs.
LEADS_WEBHOOK_URL=
