# Verídico backend (Railway). Copy to .env for local development. Never commit .env.
NODE_ENV=production
PORT=3000

# Existing, deployed SON Intelligence Gateway. The key lives ONLY here (Railway variables).
SON_INTELLIGENCE_URL=
SON_INTELLIGENCE_KEY=
# Optional (default 10000 ms). On timeout the demo falls back to deterministic-demo.
SON_INTELLIGENCE_TIMEOUT_MS=10000

# Comma-separated explicit list. https://veridico.son.enterprises is always allowed. No "*" in production.
ALLOWED_ORIGINS=

# Where "Analyze my company" requests are forwarded. Unset → UI shows the email alternative.
LEADS_WEBHOOK_URL=

# Optional (default 65536). Max request body size in bytes.
BODY_LIMIT_BYTES=65536
